# Copy/edit as needed; every script sources this file if it exists.
# Anything already exported in your shell wins over these values.

PROJECT=simci-prod
ZONE=us-central1-a
# GCS bucket holding the prebuilt release tarball. Defaults to
# hyper-demo-release-$PROJECT when left unset.
BUCKET=
CONTROL=hyper-control
COOKIE=hyper-demo-cookie
MIN_NODES=1
MAX_NODES=3
WORKER_MACHINE_TYPE=n2-standard-4
